{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/psx-decompilation-harness/toolchain.schema.json",
  "title": "PSX decompilation harness toolchain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compiler",
    "tools",
    "includeDirs",
    "flags",
    "profiles",
    "containerProfiles",
    "sdk"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/string"
        },
        "version": {
          "$ref": "#/$defs/string"
        },
        "source": {
          "$ref": "#/$defs/ownedPath"
        },
        "capabilities": {
          "$ref": "#/$defs/args",
          "description": "Legacy declarations, used only without an analysis provider."
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "profile"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/string"
            },
            "profile": {
              "$ref": "#/$defs/ownedPath"
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cc1",
        "cpp",
        "as",
        "ld",
        "objcopy",
        "objdump",
        "nm",
        "readelf",
        "python",
        "splat",
        "spimdisasm",
        "maspsx",
        "m2c"
      ],
      "properties": {
        "cc1": {
          "$ref": "#/$defs/ownedPath"
        },
        "cpp": {
          "$ref": "#/$defs/ownedPath"
        },
        "as": {
          "$ref": "#/$defs/ownedPath"
        },
        "ld": {
          "$ref": "#/$defs/ownedPath"
        },
        "objcopy": {
          "$ref": "#/$defs/ownedPath"
        },
        "objdump": {
          "$ref": "#/$defs/ownedPath"
        },
        "nm": {
          "$ref": "#/$defs/ownedPath"
        },
        "readelf": {
          "$ref": "#/$defs/ownedPath"
        },
        "python": {
          "$ref": "#/$defs/ownedPath"
        },
        "splat": {
          "$ref": "#/$defs/ownedPath"
        },
        "spimdisasm": {
          "$ref": "#/$defs/ownedPath"
        },
        "maspsx": {
          "$ref": "#/$defs/ownedPath"
        },
        "m2c": {
          "$ref": "#/$defs/ownedPath"
        },
        "psyq2elf": {
          "$ref": "#/$defs/ownedPath"
        },
        "dependencyScanner": {
          "$ref": "#/$defs/ownedPath",
          "description": "Optional dependency-only preprocessor. Defaults to tools.cpp; never produces compiled text."
        },
        "cppFrontend": {
          "$ref": "#/$defs/ownedPath",
          "description": "Explicit delegated frontend for a preprocessor driver. Standalone cpp/cccp needs no entry."
        }
      }
    },
    "includeDirs": {
      "$ref": "#/$defs/args"
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpp",
        "cc1",
        "as",
        "ld",
        "maspsx",
        "m2c",
        "spimdisasm"
      ],
      "properties": {
        "cpp": {
          "$ref": "#/$defs/args"
        },
        "cc1": {
          "$ref": "#/$defs/args"
        },
        "as": {
          "$ref": "#/$defs/args"
        },
        "ld": {
          "$ref": "#/$defs/args"
        },
        "maspsx": {
          "$ref": "#/$defs/args"
        },
        "m2c": {
          "$ref": "#/$defs/args"
        },
        "spimdisasm": {
          "$ref": "#/$defs/args"
        },
        "psyq2elf": {
          "$ref": "#/$defs/args",
          "description": "Optional identified-converter arguments; no automatic carry or byte corrections."
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cpp": {
            "$ref": "#/$defs/args"
          },
          "includeDirs": {
            "$ref": "#/$defs/args"
          },
          "cc1": {
            "$ref": "#/$defs/args"
          },
          "as": {
            "$ref": "#/$defs/args"
          },
          "ld": {
            "$ref": "#/$defs/args"
          },
          "maspsx": {
            "$ref": "#/$defs/args"
          },
          "m2c": {
            "$ref": "#/$defs/args"
          },
          "spimdisasm": {
            "$ref": "#/$defs/args"
          },
          "assembler": {
            "$ref": "#/$defs/assembler"
          }
        }
      }
    },
    "containerProfiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/string"
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "convertedDir",
        "originalDir",
        "signatures"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/string"
        },
        "convertedDir": {
          "$ref": "#/$defs/ownedPath"
        },
        "originalDir": {
          "$ref": "#/$defs/ownedPath"
        },
        "signatures": {
          "$ref": "#/$defs/ownedPath"
        },
        "headers": {
          "$ref": "#/$defs/ownedPath"
        }
      }
    },
    "assembler": {
      "$ref": "#/$defs/assembler"
    },
    "toolPins": {
      "type": "object",
      "propertyNames": { "enum": ["cc1", "cpp", "as", "ld", "objcopy", "objdump", "nm", "readelf", "python", "splat", "spimdisasm", "maspsx", "m2c", "psyq2elf", "cppFrontend"] },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["sha256"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "recipe": { "$ref": "#/$defs/ownedPath" },
          "recipeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "dependentRequired": { "recipe": ["recipeSha256"], "recipeSha256": ["recipe"] }
      }
    }
  },
  "$defs": {
    "string": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/string"
      }
    },
    "ownedPath": {
      "oneOf": [
        {
          "$ref": "#/$defs/string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "path"
          ],
          "properties": {
            "origin": {
              "enum": [
                "harness",
                "project",
                "runtime",
                "external"
              ]
            },
            "path": {
              "$ref": "#/$defs/string"
            }
          }
        }
      ]
    },
    "assembler": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "maspsx"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "gas" },
            "objectFormat": { "enum": ["elf", "ecoff"], "default": "elf" },
            "postAssembly": {
              "type": "array", "uniqueItems": true,
              "items": { "enum": ["psyq-dmpsx", "psyq-lnk"] }
            },
            "lnkLayout": { "enum": ["standard", "early"], "default": "standard" }
          }
        }
      ]
    }
  }
}
