{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSX harness target selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "target": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "linked-image" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "format"],
          "properties": {
            "kind": { "const": "relocatable-library" },
            "format": { "enum": ["elf-ar", "psyq-lib"] },
            "archives": { "$ref": "#/$defs/paths" },
            "standaloneObjects": { "$ref": "#/$defs/paths" }
          },
          "anyOf": [
            { "required": ["archives"], "properties": { "archives": { "minItems": 1 } } },
            { "required": ["standaloneObjects"], "properties": { "standaloneObjects": { "minItems": 1 } } }
          ]
        }
      ]
    },
    "headers": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "reference": { "$ref": "#/$defs/paths", "description": "Immutable reference header directories; must not overlap owned directories." },
        "owned": { "$ref": "#/$defs/paths", "description": "Project-owned declaration/type directories." },
        "context": { "$ref": "#/$defs/paths", "description": "Include spellings for source scaffolds and m2c context, resolved through toolchain includeDirs." },
        "requires": {
          "type": "object", "additionalProperties": { "$ref": "#/$defs/paths" },
          "description": "Reference headers, by include spelling, that rely on their includer having included the listed headers first. Preparation includes those first when it includes the header."
        }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["scope"],
      "properties": { "scope": { "const": "all-code-members" } }
    },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": { "enum": ["relocatable-object", "original-object"] },
        "originals": {
          "type": "object", "additionalProperties": false, "required": ["format", "map"],
          "properties": {
            "format": { "const": "psyq-lnk" }, "archives": { "$ref": "#/$defs/paths" }, "objects": { "$ref": "#/$defs/paths" },
            "map": { "type": "object", "additionalProperties": { "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["archive", "ordinal"], "properties": { "archive": { "$ref": "#/$defs/path" }, "ordinal": { "type": "integer", "minimum": 0 } } },
              { "type": "object", "additionalProperties": false, "required": ["object"], "properties": { "object": { "$ref": "#/$defs/path" } } }
            ] } }
          }
        }
      }
    },
    "views": {
      "type": "object", "additionalProperties": false, "required": ["elf"],
      "properties": { "elf": { "type": "object", "additionalProperties": { "$ref": "#/$defs/path" } } }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["sourceDir"],
      "properties": {
        "sourceDir": { "$ref": "#/$defs/path", "pattern": "^src/", "default": "src/libraries" },
        "sourceLayout": { "enum": ["grouped", "member-id", "tu-directory"], "default": "grouped", "description": "tu-directory groups one-function files and shared data under an ordered tu.json manifest, compiled as one original TU. grouped and member-id retain monolithic source files." },
        "inputRoot": { "$ref": "#/$defs/path", "description": "Directory stripped from input paths for grouped sources. Defaults to the common literal directory prefix of the configured input globs, not their matches." }
      }
    },
    "toolchainProfile": { "type": "string", "minLength": 1, "description": "Default named profile in toolchain.json." },
    "memberProfiles": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 }, "description": "Exact member ID to named toolchain profile; overrides toolchainProfile." }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "description": "Safe root-relative path; runtime rejects absolute paths, NUL and parent traversal." },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } }
  }
}
