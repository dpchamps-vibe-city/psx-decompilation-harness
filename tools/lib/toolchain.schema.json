{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/psx-decompilation-harness/toolchain.schema.json",
  "title": "PSX decompilation harness toolchain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compiler",
    "tools",
    "includeDirs",
    "flags",
    "profiles",
    "containerProfiles",
    "sdk"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/string"
        },
        "version": {
          "$ref": "#/$defs/string"
        },
        "source": {
          "$ref": "#/$defs/ownedPath"
        },
        "capabilities": {
          "$ref": "#/$defs/args",
          "description": "Legacy declarations, used only without an analysis provider."
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "profile"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/string"
            },
            "profile": {
              "$ref": "#/$defs/ownedPath"
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cc1",
        "cpp",
        "as",
        "ld",
        "objcopy",
        "objdump",
        "nm",
        "readelf",
        "python",
        "splat",
        "spimdisasm",
        "maspsx",
        "m2c"
      ],
      "properties": {
        "cc1": {
          "$ref": "#/$defs/ownedPath"
        },
        "cpp": {
          "$ref": "#/$defs/ownedPath"
        },
        "as": {
          "$ref": "#/$defs/ownedPath"
        },
        "ld": {
          "$ref": "#/$defs/ownedPath"
        },
        "objcopy": {
          "$ref": "#/$defs/ownedPath"
        },
        "objdump": {
          "$ref": "#/$defs/ownedPath"
        },
        "nm": {
          "$ref": "#/$defs/ownedPath"
        },
        "readelf": {
          "$ref": "#/$defs/ownedPath"
        },
        "python": {
          "$ref": "#/$defs/ownedPath"
        },
        "splat": {
          "$ref": "#/$defs/ownedPath"
        },
        "spimdisasm": {
          "$ref": "#/$defs/ownedPath"
        },
        "maspsx": {
          "$ref": "#/$defs/ownedPath"
        },
        "m2c": {
          "$ref": "#/$defs/ownedPath"
        },
        "psyq2elf": {
          "$ref": "#/$defs/ownedPath"
        }
      }
    },
    "includeDirs": {
      "$ref": "#/$defs/args"
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpp",
        "cc1",
        "as",
        "ld",
        "maspsx",
        "m2c",
        "spimdisasm"
      ],
      "properties": {
        "cpp": {
          "$ref": "#/$defs/args"
        },
        "cc1": {
          "$ref": "#/$defs/args"
        },
        "as": {
          "$ref": "#/$defs/args"
        },
        "ld": {
          "$ref": "#/$defs/args"
        },
        "maspsx": {
          "$ref": "#/$defs/args"
        },
        "m2c": {
          "$ref": "#/$defs/args"
        },
        "spimdisasm": {
          "$ref": "#/$defs/args"
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cpp": {
            "$ref": "#/$defs/args"
          },
          "includeDirs": {
            "$ref": "#/$defs/args"
          },
          "cc1": {
            "$ref": "#/$defs/args"
          },
          "as": {
            "$ref": "#/$defs/args"
          },
          "ld": {
            "$ref": "#/$defs/args"
          },
          "maspsx": {
            "$ref": "#/$defs/args"
          },
          "m2c": {
            "$ref": "#/$defs/args"
          },
          "spimdisasm": {
            "$ref": "#/$defs/args"
          },
          "assembler": {
            "$ref": "#/$defs/assembler"
          }
        }
      }
    },
    "containerProfiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/string"
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "convertedDir",
        "originalDir",
        "signatures"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/string"
        },
        "convertedDir": {
          "$ref": "#/$defs/ownedPath"
        },
        "originalDir": {
          "$ref": "#/$defs/ownedPath"
        },
        "signatures": {
          "$ref": "#/$defs/ownedPath"
        },
        "headers": {
          "$ref": "#/$defs/ownedPath"
        }
      }
    },
    "assembler": {
      "$ref": "#/$defs/assembler"
    }
  },
  "$defs": {
    "string": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/string"
      }
    },
    "ownedPath": {
      "oneOf": [
        {
          "$ref": "#/$defs/string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "path"
          ],
          "properties": {
            "origin": {
              "enum": [
                "harness",
                "project",
                "runtime",
                "external"
              ]
            },
            "path": {
              "$ref": "#/$defs/string"
            }
          }
        }
      ]
    },
    "assembler": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "maspsx"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inputRewrites"
          ],
          "properties": {
            "kind": {
              "const": "gas"
            },
            "inputRewrites": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "move-addu",
                  "rdata-section"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
