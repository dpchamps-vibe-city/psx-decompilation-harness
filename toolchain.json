{
  "$schema": "./tools/lib/toolchain.schema.json",
  "schemaVersion": 1,
  "compiler": {
    "family": "gcc",
    "version": "2.95.2",
    "source": "tools/vendor/gcc/2.95.2",
    "capabilities": [
      "gcc-rtl-dumps",
      "gcc-emission-attribution",
      "gcc-implicit-declarations"
    ]
  },
  "tools": {
    "cc1": "tools/vendor/old-gcc/build-gcc-2.95.2-psx/cc1",
    "cpp": "mips-linux-gnu-cpp",
    "as": "mips-linux-gnu-as",
    "ld": "mips-linux-gnu-ld",
    "objcopy": "mips-linux-gnu-objcopy",
    "objdump": "mips-linux-gnu-objdump",
    "nm": "mips-linux-gnu-nm",
    "readelf": "mips-linux-gnu-readelf",
    "python": "python3",
    "splat": "splat",
    "spimdisasm": "spimdisasm",
    "maspsx": "tools/vendor/maspsx/maspsx.py",
    "m2c": "tools/vendor/m2c/m2c.py"
  },
  "includeDirs": [
    "include",
    "include/psyq"
  ],
  "flags": {
    "cpp": [
      "-undef",
      "-D__GNUC__=2",
      "-DINCLUDE_ASM_USE_MACRO_INC=1",
      "-lang-c",
      "-D_LANGUAGE_C"
    ],
    "cc1": [
      "-O2",
      "-G8",
      "-mips1",
      "-mcpu=r3000",
      "-funsigned-char",
      "-fpeephole",
      "-ffunction-cse",
      "-fpcc-struct-return",
      "-fcommon",
      "-fverbose-asm",
      "-msoft-float",
      "-mgas",
      "-fgnu-linker",
      "-quiet"
    ],
    "as": [
      "-march=r3000",
      "-mtune=r3000",
      "-EL",
      "-G8",
      "-no-pad-sections"
    ],
    "ld": [
      "-EL"
    ],
    "maspsx": [
      "--aspsx-version",
      "2.80",
      "--use-comm-section",
      "--run-assembler"
    ],
    "m2c": [
      "--target",
      "mipsel-gcc-c"
    ],
    "spimdisasm": [
      "--arch-level",
      "MIPS1",
      "--instr-category",
      "r3000gte",
      "--compiler",
      "PSYQ",
      "--endian",
      "little"
    ]
  },
  "profiles": {},
  "containerProfiles": {},
  "sdk": {
    "version": "470",
