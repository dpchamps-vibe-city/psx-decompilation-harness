{
  "name": "psx-decompilation-harness",
  "private": true,
  "version": "1.0.0",
  "description": "PSX matching-decompilation tools, build pipeline and Pi workflows",
  "pi": {
    "extensions": [
      "./.pi/extensions/psx-bootstrap/index.ts",
      "./.pi/extensions/psx-decomp/index.ts",
      "./.pi/extensions/psx-resources/index.ts"
    ],
    "skills": [
      "./.pi/skills"
    ]
  },
  "files": [
    ".pi/extensions",
    ".pi/skills",
    "tools",
    "templates",
    "docs",
    "prompts/reference",
    "include",
    "!tools/vendor/psyq47/**",
    "!tools/vendor/old-gcc/build-gcc-*/**",
    "!include/psyq/**",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "test": "tsx --test .pi/extensions/shared/*.test.ts .pi/extensions/psx-decomp/autoloop/*.test.ts .pi/extensions/psx-decomp/tools/*.test.ts tools/lib/*.test.ts tools/build/*.test.ts tools/diagnostics/*.test.ts tools/agent/*.test.ts tools/agent/idiom-corpus/*.test.ts tools/agent/compiler-source/*.test.ts tools/agent/compiler-trace/*.test.ts tools/agent/loop-trace/*.test.ts tools/agent/loop-emission/*.test.ts tools/agent/allocator-counterfactual/*.test.ts tools/agent/compiler-oracle/*.test.ts tools/agent/variant-lab/*.test.ts tools/agent/target-schedule/*.test.ts tools/agent/scheduler-constraint/*.test.ts tools/agent/source-shape-search/*.test.ts tools/agent/source-shape-synthesis/*.test.ts tools/agent/residual-source-search/*.test.ts tools/agent/pipeline-reversal/*.test.ts tools/agent/matching-reconstruction/*.test.ts tools/agent/family-transfer/*.test.ts tools/agent/machine-ir/*.test.ts tools/agent/recipe-atlas/*.test.ts tools/agent/campaign/*.test.ts tools/agent/resource-extraction/*.test.ts tools/agent/resource-extraction/parsers/*.test.ts .pi/extensions/psx-resources/*.test.ts tools/testing/*.test.ts",
    "build": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts build",
    "check": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts check",
    "check-exe": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts check-exe",
    "check-all": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts check-all",
    "disassemble": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts disassemble",
    "split": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts split",
    "split-all": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts split-all",
    "split-sdk-libs": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts split-sdk-libs",
    "config-check": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts config-check",
    "clean": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts clean",
    "wipe": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts wipe",
    "setup": "node --import tsx tools/lib/scriptHost.ts tools/build/pipeline.ts setup",
    "analysis-support": "node --import tsx tools/lib/scriptHost.ts tools/agent/analysisSupport.ts",
    "compiler-source": "node --import tsx tools/lib/scriptHost.ts tools/agent/compilerSource.ts",
    "prepare-compiler-source": "node --import tsx tools/lib/scriptHost.ts tools/build/prepareCompilerSource.ts",
    "bootstrap": "tsx tools/build/scaffoldProject.ts",
    "profile": "node --import tsx tools/lib/scriptHost.ts tools/build/genProjectProfile.ts",
    "identify": "node --import tsx tools/lib/scriptHost.ts tools/diagnostics/identifyToolchain.ts",
    "library": "node --import tsx tools/lib/scriptHost.ts tools/agent/library.ts",
    "progress": "node --import tsx tools/lib/scriptHost.ts tools/diagnostics/progress.ts",
    "macro-identity": "node --import tsx tools/lib/scriptHost.ts tools/diagnostics/macroIdentity.ts",
    "macro-evidence": "node --import tsx tools/lib/scriptHost.ts tools/diagnostics/macroEvidence.ts",
    "web-partition": "node --import tsx tools/lib/scriptHost.ts tools/diagnostics/fingerprintWebPartition.ts",
    "web-partition-replay": "node --import tsx tools/lib/scriptHost.ts tools/diagnostics/webPartitionReplay.ts",
    "extract-assets": "node --import tsx tools/lib/scriptHost.ts tools/agent/resourceExtract.ts",
    "assets": "node --import tsx tools/lib/scriptHost.ts tools/agent/resourceExtract.ts",
    "diff": "node --import tsx tools/lib/scriptHost.ts tools/agent/diffFunc.ts"
  },
  "keywords": [
    "pi-package",
    "playstation",
    "decompilation"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "typebox": "^1.3.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.26.11"
  },
  "exports": {
    "./resource-parsers": "./tools/agent/resource-extraction/registry.ts"
  }
}
